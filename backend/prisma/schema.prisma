generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum UserRole {
  ADMIN
  PARENT
  THERAPIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  ARCHIVED
}

enum OtpType {
  EMAIL_VERIFICATION // Sent during registration to confirm email ownership
  PASSWORD_RESET     // Sent for forgotten password recovery
}

//////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////

model User {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  email           String    @unique
  phone           String    @unique
  areaofexpertise String?
  password        String
  refreshToken    String?
  role            UserRole
  avatar          String?
  isApproved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Parent relationships
  children ChildParent[]

  // Therapist relationships
  therapistAssignments TherapistAssignment[]
  sessions             Session[]             @relation("TherapistSessions")

  // Goal creator
  createdGoals Goal[] @relation("GoalCreator")

  // Messaging
  sentMessages             Message[]                 @relation("UserMessages")
  conversationParticipants ConversationParticipant[]

  // Notifications
  notifications Notification[]

  // Uploaded resources
  resources Resource[]

  // Uploaded file attachments
  fileAttachments FileAttachment[]

  // Phase 3: Booking system
  availabilitySlots AvailabilitySlot[]
  bookingsAsParent  Booking[] @relation("BookingParent")
  bookingsAsTherapist Booking[] @relation("BookingTherapist")

  // Phase 3: Payments & Subscriptions
  transactions      Transaction[]
  userSubscriptions UserSubscription[]

  @@index([email])
  @@index([role])
}

//////////////////////////////////////////////////
// CHILDREN
//////////////////////////////////////////////////

model Child {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      Gender
  diagnosis   String?
  school      String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parents    ChildParent[]
  therapists TherapistAssignment[]
  intakeForm IntakeForm?
  goals      Goal[]
  sessions   Session[]
  behaviours Behaviour[]
  fileAttachments FileAttachment[]

  // Phase 3: Booking system
  bookings Booking[]

  @@index([lastName])
}

//////////////////////////////////////////////////
// CHILD ↔ PARENT
//////////////////////////////////////////////////

model ChildParent {
  id           String  @id @default(uuid())
  childId      String
  parentId     String
  relationship String?

  child  Child @relation(fields: [childId], references: [id])
  parent User  @relation(fields: [parentId], references: [id])

  @@unique([childId, parentId])
}

//////////////////////////////////////////////////
// CHILD ↔ THERAPIST
//////////////////////////////////////////////////

model TherapistAssignment {
  id          String   @id @default(uuid())
  childId     String
  therapistId String
  assignedAt  DateTime @default(now())

  child     Child @relation(fields: [childId], references: [id])
  therapist User  @relation(fields: [therapistId], references: [id])

  @@unique([childId, therapistId])
}

//////////////////////////////////////////////////
// INTAKE FORM
//////////////////////////////////////////////////

model IntakeForm {
  id                   String @id @default(uuid())
  childId              String @unique
  developmentalHistory String
  behaviourConcerns    String
  parentGoals          String

  child Child @relation(fields: [childId], references: [id])
}

//////////////////////////////////////////////////
// GOALS
//////////////////////////////////////////////////

model Goal {
  id          String     @id @default(uuid())
  childId     String
  title       String
  description String
  status      GoalStatus @default(NOT_STARTED)
  createdById String
  createdAt   DateTime   @default(now())

  child     Child @relation(fields: [childId], references: [id])
  createdBy User  @relation("GoalCreator", fields: [createdById], references: [id])

  @@index([childId])
}

//////////////////////////////////////////////////
// SESSIONS
//////////////////////////////////////////////////

model Session {
  id          String   @id @default(uuid())
  childId     String
  therapistId String
  sessionDate DateTime
  duration    Int?
  createdAt   DateTime @default(now())

  child     Child        @relation(fields: [childId], references: [id])
  therapist User         @relation("TherapistSessions", fields: [therapistId], references: [id])
  note      SessionNote?
  fileAttachments FileAttachment[]

  @@index([childId])
  @@index([therapistId])
  @@index([sessionDate])
}

//////////////////////////////////////////////////
// SESSION NOTES
//////////////////////////////////////////////////

model SessionNote {
  id              String @id @default(uuid())
  sessionId       String @unique
  goalsWorkedOn   String
  observations    String
  recommendations String

  session Session @relation(fields: [sessionId], references: [id])
}

//////////////////////////////////////////////////
// BEHAVIOURS
//////////////////////////////////////////////////

model Behaviour {
  id          String  @id @default(uuid())
  childId     String
  name        String
  description String?

  child Child          @relation(fields: [childId], references: [id])
  logs  BehaviourLog[]

  @@index([childId])
}

//////////////////////////////////////////////////
// BEHAVIOUR LOGS
//////////////////////////////////////////////////

model BehaviourLog {
  id          String   @id @default(uuid())
  behaviourId String
  frequency   Int
  notes       String?
  recordedAt  DateTime

  behaviour Behaviour @relation(fields: [behaviourId], references: [id])

  @@index([recordedAt])
}

//////////////////////////////////////////////////
// CONVERSATIONS
//////////////////////////////////////////////////

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

//////////////////////////////////////////////////
// CONVERSATION PARTICIPANTS
//////////////////////////////////////////////////

model ConversationParticipant {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

//////////////////////////////////////////////////
// MESSAGES
//////////////////////////////////////////////////

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("UserMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

//////////////////////////////////////////////////
// OTP CODES
//////////////////////////////////////////////////

model OtpCode {
  id        String   @id @default(uuid()) // Primary key
  email     String                        // Recipient email address
  code      String                        // 6-digit OTP code
  type      OtpType                       // Purpose: EMAIL_VERIFICATION or PASSWORD_RESET
  expiresAt DateTime                      // TTL — codes expire after 10 minutes
  isUsed    Boolean  @default(false)      // Whether the code has been consumed
  createdAt DateTime @default(now())      // Timestamp when the code was generated
  usedAt    DateTime?                      // Timestamp when the code was consumed

  @@index([email])          // Fast lookup of all codes sent to an email
  @@index([code])           // Fast lookup by code value during verification
  @@index([email, type])    // Composite index for "get latest valid code of type X for email Y"
}

//////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

//////////////////////////////////////////////////
// RESOURCES (library: articles, videos, PDFs)
//////////////////////////////////////////////////

// Discriminator enum for resource library items — tells the UI which icon and
// layout to use when displaying the resource card (article, video, or PDF).
enum ResourceType {
  ARTICLE
  VIDEO
  PDF
}

// Resource — a shareable library item (article, video, or PDF) curated by
// therapists or admins for parents. Each resource has a title, optional
// description, type discriminator, and external URL. The uploader is tracked
// for attribution. Only ADMIN and THERAPIST roles may create resources; only
// ADMIN may delete them (enforced at the route level).
model Resource {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        ResourceType
  url         String
  uploadedById String
  createdAt   DateTime     @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([type])
  @@index([title])
}

//////////////////////////////////////////////////
// FILE ATTACHMENTS (uploaded reports, assessments, etc.)
//////////////////////////////////////////////////

// FileAttachment — metadata for files uploaded to Cloudinary (reports, assessments,
// documents, videos, etc.). Each attachment can optionally be linked to a child
// and/or a therapy session for organisational context. The publicId is stored
// so the file can be deleted from Cloudinary when the attachment is removed.
// Files are limited to 10 MB at the multer middleware level.
model FileAttachment {
  id        String   @id @default(uuid())
  childId   String?
  sessionId String?
  fileName  String          // Original filename from the uploader's device
  url       String          // Full Cloudinary URL for viewing / downloading
  publicId  String          // Cloudinary asset public ID (required for deletion)
  mimeType  String          // MIME type detected by Cloudinary / multer
  size      Int?            // File size in bytes
  uploadedById String
  createdAt DateTime @default(now())

  child     Child?  @relation(fields: [childId], references: [id])
  session   Session? @relation(fields: [sessionId], references: [id])
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([childId])
  @@index([sessionId])
}

//////////////////////////////////////////////////
// BOOKING SYSTEM (Phase 3)
//////////////////////////////////////////////////

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model AvailabilitySlot {
  id          String   @id @default(uuid())
  therapistId String
  dayOfWeek   Int?              // 0=Sun..6=Sat, null for specificDate
  specificDate DateTime?        // Non-recurring date override
  startTime   String            // "09:00"
  endTime     String            // "10:00"
  isRecurring Boolean  @default(true)
  createdAt   DateTime @default(now())

  therapist User      @relation(fields: [therapistId], references: [id])
  bookings  Booking[]

  @@index([therapistId])
  @@index([dayOfWeek])
}

model Booking {
  id          String        @id @default(uuid())
  slotId      String
  childId     String
  parentId    String
  therapistId String
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  slot      AvailabilitySlot @relation(fields: [slotId], references: [id])
  child     Child            @relation(fields: [childId], references: [id])
  parent    User             @relation("BookingParent", fields: [parentId], references: [id])
  therapist User             @relation("BookingTherapist", fields: [therapistId], references: [id])

  @@index([slotId])
  @@index([childId])
  @@index([therapistId])
  @@index([parentId])
  @@index([status])
}

//////////////////////////////////////////////////
// PAYMENTS & SUBSCRIPTIONS (Phase 3)
//////////////////////////////////////////////////

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Transaction {
  id            String        @id @default(uuid())
  userId        String
  email         String
  amount        Int           // Amount in pesewas (GHS smallest unit)
  currency      String        @default("GHS")
  reference     String        @unique
  status        PaymentStatus @default(PENDING)
  metadata      Json?
  bookingId     String?
  subscriptionId String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([bookingId])
}

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Int      // Price in pesewas (GHS)
  duration    Int      // Duration in days
  features    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userSubscriptions UserSubscription[]
}

model UserSubscription {
  id               String   @id @default(uuid())
  userId           String
  planId           String
  startDate        DateTime @default(now())
  endDate          DateTime
  status           String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  transactionId    String?
  autoRenew        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User               @relation(fields: [userId], references: [id])
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
}
