NODE_ENV=production
PORT=5000

# Comma-separate origins when you need production + preview frontends.
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app
COOKIE_SAME_SITE=none

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SALT_ROUNDS=10
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ADMIN_INVITE_CODE=replace-with-admin-invite-code

CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

PAYSTACK_SECRET_KEY=replace-with-secret-key
PAYSTACK_PUBLIC_KEY=replace-with-public-key
PAYSTACK_WEBHOOK_SECRET=replace-with-webhook-secret

SESSION_FEE_PESEWAS=15000

EMAIL_NOTIFICATIONS_ENABLED=false
SMS_NOTIFICATIONS_ENABLED=false

# Email: use Resend or SMTP.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
EMAIL_FROM=Neuro Bridge Africa <noreply@your-verified-domain.com>
EMAIL_REPLY_TO=support@your-verified-domain.com
EMAIL_TIMEOUT_MS=10000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# SMS: Arkesel sender IDs must be 11 characters or fewer.
ARKESEL_API_KEY=
ARKESEL_SMS_URL=https://sms.arkesel.com/api/v2/sms/send
ARKESEL_SENDER_ID=NeuroBridge
SMS_TIMEOUT_MS=10000
